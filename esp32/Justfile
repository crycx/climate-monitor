# Build commands
build-wroom:
    cd wroom && cargo build --release --target xtensa-esp32-none-elf

build-c3:
    cd c3 && cargo build --release --target riscv32imc-unknown-none-elf

# Check commands (fast iteration)
check-wroom:
    cd wroom && cargo check --target xtensa-esp32-none-elf

check-c3:
    cd c3 && cargo check --target riscv32imc-unknown-none-elf

# Run/flash (runner is set in .cargo/config.toml)
run-wroom:
    cd wroom && cargo run --release --target xtensa-esp32-none-elf

run-c3:
    cd c3 && cargo run --release --target riscv32imc-unknown-none-elf

# Clean
clean-wroom:
    cd wroom && cargo clean

clean-c3:
    cd c3 && cargo clean

# Combined
check-all: check-wroom check-c3
build-all: build-wroom build-c3
