# Source PostgreSQL (server where cron runs)
SRC_PG_HOST=127.0.0.1
SRC_PG_PORT=5432
SRC_PG_DB=climate_monitor
SRC_PG_USER=postgres
SRC_PG_PASSWORD=
SRC_PG_SSLMODE=prefer

# Target MySQL (Zone)
# From phpMyAdmin screenshot, server is usually something like d125709.mysql.zonevs.eu
TARGET_MYSQL_HOST=d125709.mysql.zonevs.eu
TARGET_MYSQL_PORT=3306
TARGET_MYSQL_DB=d125709_climatemonitor
TARGET_MYSQL_USER=d125709_materjal
TARGET_MYSQL_PASSWORD=

# Sync behavior
SYNC_BATCH_SIZE=2000
SYNC_STATE_FILE=/opt/climate-sync/push_readings_state.json
