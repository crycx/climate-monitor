APP_PORT=8000

POSTGRES_PASSWORD=change-me
POSTGRES_DB=climate_monitor

SECRET_KEY=change-me-very-secret
FRONTEND_ORIGIN=https://climate.sinpal.ee
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax

# Password reset
FRONTEND_RESET_URL=https://climate.sinpal.ee/reset-password
RESET_TOKEN_TTL_MINUTES=30
EXPOSE_RESET_TOKEN_IN_RESPONSE=false

# SMTP (set for real email delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=no-reply@climate-monitor.local

# Rate limits
FORGOT_PASSWORD_RATE_LIMIT_COUNT=5
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900
RESET_PASSWORD_RATE_LIMIT_COUNT=10
RESET_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900
